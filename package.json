{
  "name": "@byterover/brv-bridge",
  "version": "2.0.0",
  "description": "Standard interface for connecting agent frameworks to ByteRover's Context Tree.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "ByteRover",
  "license": "Elastic-2.0",
  "keywords": [
    "byterover",
    "context-tree",
    "agent",
    "memory",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfirein/brv-bridge.git"
  },
  "homepage": "https://github.com/campfirein/brv-bridge#readme",
  "bugs": {
    "url": "https://github.com/campfirein/brv-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
